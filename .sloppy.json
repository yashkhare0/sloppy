{
  "version": 1,
  "project": {
    "typescript": false,
    "javascript": true,
    "python": true,
    "react": false,
    "next": false,
    "shadcn": false
  },
  "include": [
    "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,py}"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/.git/**",
    "**/.next/**",
    "**/.output/**",
    "**/.nuxt/**",
    "**/convex/_generated/**",
    "**/.venv*/**",
    "**/.claude/worktrees/**",
    "**/.codex/worktrees/**",
    "**/.tmp-tests-fs/**",
    "**/venv/**",
    "**/__pycache__/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.d.ts",
    "**/*.generated.*"
  ],
  "limits": {
    "file": [
      300,
      500
    ],
    "function": [
      40,
      80
    ],
    "component": [
      100,
      180
    ],
    "class": [
      200,
      350
    ],
    "complexity": [
      8,
      12
    ],
    "nesting": [
      3,
      4
    ],
    "parameters": [
      4,
      6
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/test_*.py",
        "**/tests/**",
        "**/test/**"
      ],
      "reason": "Tests often contain repetitive arrangements and assertions.",
      "limits": {
        "file": [
          500,
          800
        ],
        "function": [
          80,
          160
        ]
      }
    }
  ],
  "naming": {
    "files": true,
    "identifiers": true
  },
  "boundaries": [
    {
      "from": [
        "src/domain/**"
      ],
      "disallow": [
        "src/analysis/**",
        "src/assessment/**",
        "src/cli/**",
        "src/git/**",
        "src/project/**",
        "src/runtime/**"
      ],
      "reason": "Domain invariants must not depend on orchestration, project policy or runtime adapters."
    }
  ],
  "checks": {
    "javascriptLint": true,
    "typescriptLint": false,
    "typescriptTypes": false,
    "pythonLint": true,
    "pythonTypes": true,
    "pythonUnusedCode": true,
    "pythonCoverage": false,
    "pythonDependencyAudit": false
  },
  "typescript": {
    "projects": [
      "tsconfig.json"
    ],
    "requiredOptions": [
      "strict",
      "noUncheckedIndexedAccess",
      "exactOptionalPropertyTypes"
    ],
    "eslintRules": {}
  },
  "python": {
    "executable": "python",
    "ruffExecutable": "ruff",
    "ruffSelect": [
      "E4",
      "E7",
      "E9",
      "F",
      "B",
      "I",
      "N",
      "ASYNC",
      "ANN",
      "BLE",
      "PGH",
      "RUF"
    ],
    "typeCheckingMode": "strict",
    "vultureExecutable": "vulture",
    "vultureMinConfidence": 60,
    "maxActivityLines": 30,
    "maxInlinePromptLines": 3,
    "coverageReport": null,
    "coverageMinimum": 60,
    "dependencyFile": null,
    "uvExecutable": "uv",
    "pipAuditExecutable": "pip-audit",
    "severities": {
      "python/nested-loop": "major",
      "python/raw-dict-return": "major",
      "python/inline-client": "major",
      "python/inline-prompt": "minor",
      "python/fat-activity": "critical",
      "python/unused-definition": "major",
      "python/dependency-cve": "critical"
    }
  },
  "baseline": null,
  "deadCode": {
    "entryPoints": [],
    "protected": []
  },
  "organization": {
    "sourceRoots": [
      "src"
    ],
    "forbiddenNames": [
      "helpers",
      "utils",
      "common",
      "misc",
      "types"
    ],
    "compositionRoots": [
      "src/cli/**"
    ],
    "rootFileWarning": 8,
    "requireOwnership": true,
    "requireOwnerTests": false,
    "exemptions": [],
    "owners": [
      {
        "name": "analysis-javascript",
        "sources": [
          "src/analysis/javascript/**"
        ],
        "tests": [
          "tests/analysis/javascript/**"
        ]
      },
      {
        "name": "analysis-python",
        "sources": [
          "src/analysis/python/**"
        ],
        "tests": [
          "tests/analysis/python/**"
        ]
      },
      {
        "name": "assessment",
        "sources": [
          "src/assessment/**"
        ],
        "tests": [
          "tests/assessment/**"
        ]
      },
      {
        "name": "domain",
        "sources": [
          "src/domain/**"
        ],
        "tests": [
          "tests/domain/**"
        ]
      },
      {
        "name": "project",
        "sources": [
          "src/project/**"
        ],
        "tests": [
          "tests/project/**"
        ]
      },
      {
        "name": "runtime",
        "sources": [
          "src/runtime/**"
        ],
        "tests": [
          "tests/runtime/**"
        ]
      },
      {
        "name": "git",
        "sources": [
          "src/git/**"
        ],
        "tests": [
          "tests/git/**"
        ]
      }
    ]
  }
}
